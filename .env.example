# Aartha — Environment Variables Example
# ============================================================
# IMPORTANT: Copy this file to .env.local for local development.
# NEVER commit .env.local to version control.
# ============================================================

# Session signing secret — MUST be changed before production
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
ARTHA_SESSION_SECRET=your_64_character_hex_session_secret_here

# Admin access secret — MUST be changed before production
ARTHA_ADMIN_SECRET=your_secure_admin_secret_here

# Public base URL
NEXT_PUBLIC_BASE_URL=https://aartha.site

# Supabase Production PostgreSQL Database & Storage
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Payment Gateway (Razorpay)
PAYMENT_PROVIDER=razorpay
RAZORPAY_KEY_ID=rzp_live_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# GSTIN Registry Verification Sandbox (Optional)
SANDBOX_API_KEY=your_sandbox_api_key_here
SANDBOX_API_SECRET=your_sandbox_api_secret_here

# Transactional Email (Resend)
RESEND_API_KEY=re_123456789_your_resend_key_here

# OpenAI API Key (AI Assistant & Doc Intelligence)
OPENAI_API_KEY=sk-proj-your-openai-api-key-here

# Cloudflare Turnstile Bot Protection (Optional)
TURNSTILE_SECRET_KEY=your_turnstile_secret_key

# Google OAuth Credentials (Optional)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=https://aartha.site/api/auth/google/callback

